{
  "functions": [
    {
      "source": "functions",
      "codebase": "nexus-ops",
      "runtime": "nodejs22",
      "predeploy": "node ../scripts/prepare-game-admin.cjs"
    }
  ],
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "local-config.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://www.google.com https://www.recaptcha.net; style-src 'self'; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.appcheck.debug https://www.google.com https://www.gstatic.com http://127.0.0.1:*; frame-src https://*.google.com https://*.recaptcha.net; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
          }
        ]
      }
    ],
    "target": "nexus-game-admin"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
